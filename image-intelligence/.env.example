# Copy to .env and adjust. All values are optional.

# Uploads
MAX_UPLOAD_MB=15
MAX_PIXELS=40000000
# Images are analysed in memory and NOT stored. Set true to keep a copy in uploads/.
SAVE_UPLOADS=false
UPLOAD_DIR=uploads

# Models
MODELS_DIR=models
OCR_ENGINE=easyocr            # easyocr | none
OCR_LANGUAGES=en              # e.g. en,hi
OCR_MIN_CONFIDENCE=0.30
YOLO_MODEL=yolov8n.pt         # yolov8s.pt = more accurate, slower
YOLO_CONFIDENCE=0.35
YUNET_MODEL=face_detection_yunet_2023mar.onnx

# Privacy: GPS coordinates from EXIF are hidden unless enabled (only "gps_present" is returned).
INCLUDE_GPS=false

LOG_LEVEL=INFO
