# Copy to .env and fill in. Never commit .env.

# Optional. Enables ratings, reviews, open-now, phone and website from Google
# Places API (New). Restrict the key to "Places API (New)" + your server IP.
# Leave empty to use OpenStreetMap only (free, no key).
GOOGLE_MAPS_API_KEY=

# Recommended by the OpenStreetMap usage policies (Nominatim / Overpass).
CONTACT_EMAIL=

# Prayer calculation: auto | MWL | ISNA | EGYPT | MAKKAH | KARACHI | TEHRAN | JAFARI
#                      GULF | KUWAIT | QATAR | SINGAPORE | TURKEY | FRANCE | RUSSIA | DUBAI
PRAYER_METHOD=auto
# auto | standard | hanafi
ASR_METHOD=auto

CACHE_TTL_MOSQUES=1800
CACHE_TTL_GEOCODE=86400
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org
