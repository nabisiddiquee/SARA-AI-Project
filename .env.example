# Copy this file to ".env" and fill in your values.

# Claude (Anthropic) — Sara's AI brain. Get a key at https://console.anthropic.com/settings/keys
# (API access is billed separately from a Claude Pro subscription.)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional: ChatGPT (OpenAI) instead — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-key-here
# AI_PROVIDER=anthropic   (or openai, or ollama for offline)

# Optional: offline AI via Ollama (https://ollama.com). Used automatically when no
# key is set, or when the online AI fails.
# OLLAMA_MODEL=gemma3:4b

# Optional: lock the web dashboard with a PIN (recommended when using `serve --lan`).
# Anyone opening the dashboard must enter this PIN to unlock it.
# SARA_PIN=1234

# Optional: default city for "mausam kaisa hai".
# SARA_CITY=Darbhanga

# Optional: send emails (Gmail App Password, not your normal password).
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop
# The same App Password also lets Sara announce new Gmail emails (enable IMAP in
# Gmail settings). Turn alerts off with SARA_EMAIL_ALERTS=0 / SARA_WHATSAPP_ALERTS=0.
# Every 10 hours the face snapshots in captures/ are zipped, emailed (to
# CAPTURES_EMAIL_TO, default SMTP_USER) and deleted once sent.
# CAPTURES_EMAIL_HOURS=10   (0 = off)

# Blue Star Smart AC: the login you use in the Blue Star Smart app.
# BLUESTAR_USER=9876543210
# BLUESTAR_PASSWORD=
# Optional: part of the AC name that voice commands control (if you have several).
# BLUESTAR_AC=Bedroom
